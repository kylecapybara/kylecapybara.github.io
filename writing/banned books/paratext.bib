
@article{ruokkeinen_material_2017,
	title = {Material Approaches to Exploring the Borders of Paratext},
	volume = {11},
	issn = {15592936, 19337418},
	url = {https://www.jstor.org/stable/26662794},
	abstract = {[This paper studies the interplay of text and paratext using late medieval and early modern printed and manuscript sources. We argue that the paratext framework should include a distinction between the abstract and material notions of text, as it is the features of the material text which help identify intersections between text and paratext. Three elements, namely enlarged initials, notes, and type- and script-switches, are analysed to show how paratextual elements are often layered, and may have both textual and paratextual functions at the same time. What results is a complex network of elements in different textual and paratextual relationships.]},
	pages = {106--129},
	number = {1},
	journaltitle = {Textual Cultures},
	author = {Ruokkeinen, Sirkku and Liira, Aino},
	urldate = {2024-03-07},
	date = {2017},
	note = {Publisher: [Society for Textual Scholarship, Indiana University Press]},
	file = {Full Text:/Users/kylewodehouse/Zotero/storage/WD3YZ8J3/Ruokkeinen and Liira - 2017 - Material Approaches to Exploring the Borders of Pa.pdf:application/pdf},
}

